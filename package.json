{
  "name": "av-compliance-checker",
  "displayName": "AV Compliance Checker",
  "version": "1.0.0",
  "author": "AI Lab Hackathon",
  "type": "module",
  "description": "Autonomous vehicle compliance checker API for London",
  "main": "src/proxy/index.ts",
  "homepage": "https://github.com/dvsa/dvsa-serverless-starter",
  "license": "MIT",
  "keywords": [
    "serverless",
    "typescript",
    "nodejs",
    "di",
    "lambda"
  ],
  "engines": {
    "node": "24.10.*",
    "npm": "11.6.*"
  },
  "scripts": {
    "prepare": "husky",
    "build": "bun run clean && bun build-service.ts",
    "clean": "rimraf build dist",
    "clean:artifacts": "rimraf artifacts",
    "generate-openapi-spec": "bun docs/generate-openapi-spec.ts",
    "lint": "biome check src tests",
    "lint:fix": "bun run lint -- --write",
    "package": "bun run build -- --package",
    "secretScan": "git secrets --scan && git secrets --register-aws && git log -p --diff-filter=d -- . ':!*.json' -n 250 | scanrepo",
    "start": "bun run clean && bun run build -- --source-map && sls offline start",
    "start:debug": "bun run clean && bun build-service.ts --source-map && NODE_OPTIONS='--inspect' SLS_DEBUG=* sls offline start --useInProcess",
    "test": "bun run clean && jest",
    "test:coverage": "bun run test -- --coverage"
  },
  "dependencies": {
    "@aws-lambda-powertools/commons": "^2.33.0",
    "@aws-lambda-powertools/logger": "^2.33.0",
    "@aws-lambda-powertools/parser": "^2.33.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "serverless-http": "^4.0.0",
    "typedi": "^0.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@dvsa/biome-config": "1.0.0",
    "@dvsa/openapi-schema-generator": "^2.2.0",
    "@dvsa/service-bundler": "3.0.0",
    "@swc/core": "^1.15.21",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "^8.10.161",
    "@types/bun": "^1.3.12",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.12",
    "@types/supertest": "^6.0.3",
    "bun": "^1.3.12",
    "class-validator-jsonschema": "^5.1.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "js-yaml": "^4.1.1",
    "lint-staged": "^16.4.0",
    "multer": "^2.0.2",
    "osls": "^3.62.2",
    "rimraf": "^6.1.3",
    "routing-controllers-openapi": "^5.0.1",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^14.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "lint-staged": {
    "*.{js,ts,mjs,css,md,ts,json}": "npm run lint:fix -- --no-errors-on-unmatched"
  },
  "overrides": {
    "serverless": "npm:osls",
    "typescript": "$typescript"
  }
}
